# 视频后端：agnes（小云雀）| jimeng（即梦）| minimax
VIDEO_PROVIDER=agnes

# LLM/VL：agnes 走云端，无需本地 Qwen（本地强制用 FORCE_LOCAL_LLM=1）
LLM_PROVIDER=agnes
AGNES_CHAT_MODEL=agnes-2.5-flash
AGNES_PROMPT_MODEL=agnes-1.5-flash
AGNES_IMAGE_MODEL=agnes-image-2.1-flash
ENRICH_DISSECT=0
JEWELRY_MODE=1

# Agnes AI
AGNES_API_KEY=sk-your-agnes-key
AGNES_BASE_URL=https://apihub.agnes-ai.com
AGNES_VIDEO_MODEL=agnes-video-v2.0
AGNES_MIN_CREATE_INTERVAL=61
AGNES_POLL_INTERVAL=8
AGNES_POLL_TIMEOUT=900

# 即梦 / 火山引擎（VIDEO_PROVIDER=jimeng 时使用）
VOLC_ACCESSKEY=
VOLC_SECRETKEY=

# MiniMax（备用）
MINIMAX_API_KEY=sk-api-your-key-here
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_POLL_INTERVAL=8
MINIMAX_POLL_TIMEOUT=900

# 本地模型路径（LLM_PROVIDER 非 agnes 或 FORCE_LOCAL_LLM=1 时使用）
FORCE_LOCAL_LLM=0
BASE_MODEL_DIR=
VL_MODEL_DIR=
ADAPTER_DIR=

# 项目存储
STUDIO_PROJECTS_DIR=data/studio_projects

# 云端部署
PORT=6006
